# =============================================================================
# MyTask — variáveis de produção
# Copie este arquivo para `.env` na raiz do repositório no servidor:
#   cp .env.prod.example .env
# Nunca versionar o `.env` real.
# =============================================================================

# --- Domínio e proxy reverso (nginx-proxy / Let's Encrypt) ---
VIRTUAL_HOST=mytask.tiagoaugusto.com
LETSENCRYPT_HOST=mytask.tiagoaugusto.com
LETSENCRYPT_EMAIL=seu-email@exemplo.com

# --- Backend Laravel ---
APP_NAME=MyTask
APP_ENV=production
APP_DEBUG=false
APP_URL=https://mytask.tiagoaugusto.com
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# Gere com:
#   openssl rand -base64 32
# e prefixe com base64:   APP_KEY=base64:<saida>
APP_KEY=

AUTH_GUARD=api

# Gere com:
#   openssl rand -base64 64
JWT_SECRET=
JWT_TTL=60

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Banco MySQL (usado pelo Compose e pelo Laravel) ---
MYSQL_DATABASE=mytask
MYSQL_USER=mytask
MYSQL_PASSWORD=altere-esta-senha
MYSQL_ROOT_PASSWORD=altere-esta-senha-root

# --- Administrador inicial (usado apenas no seed) ---
ADMIN_NICKNAME=Administrador
ADMIN_EMAIL=admin@mytask.local
ADMIN_PASSWORD=altere-esta-senha-admin

# --- Frontend Nuxt (same-origin) ---
NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_APP_TIMEZONE=America/Sao_Paulo

# URL do formulário TAM (opcional). Vazio = convite desativado.
# Após alterar, reconstrua a imagem do frontend:
#   docker compose -f docker-compose.prod.yml build frontend
NUXT_PUBLIC_TAM_FORM_URL=
